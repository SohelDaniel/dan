# readback t=41.9s
title "Where the interest comes from"
schema graph
mark you dot person savings=259 shape=circle label=You
mark bank dot company reserves=60 shape=square label=Bank
mark borrower dot person loan=200 shape=circle label=Borrower
link d1 arrow you -> bank label=deposit
link l1 arrow bank -> borrower label=lends
link r1 arrow borrower -> bank label="repays + 15%"
link i1 arrow bank -> you label="pays 10%"
