# readback t=23.3s
title "Gradient descent"
schema plane x=[-3,3] y=[-2,2]
mark L heat fn={x^2 + 6*y^2}
mark C contour fn={x^2 + 6*y^2} levels=log
mark p dot x=-0.577 y=-0.077 trail=all label=you
camera zoom=2 on=p
