+Vector2 drift(const TexLayout &from, const TexLayout &to, int *pairs) {
+  std::map<std::string, std::vector<Vector2>> was;
+  for (auto &g : from.glyphs) was[g.key].push_back(g.at);
+  std::map<std::string, size_t> seen;
+  Vector2 sum{0, 0};
+  int n = 0;
+  for (auto &g : to.glyphs) {
+    auto it = was.find(g.key);
+    size_t k = seen[g.key]++;
+    if (it == was.end() || k >= it->second.size()) continue;
+    sum.x += g.at.x - it->second[k].x;
+    sum.y += g.at.y - it->second[k].y;
+    n++;
+  }
+  if (pairs) *pairs = n;
+  return n ? Vector2{sum.x / n, sum.y / n} : Vector2{0, 0};
+}
