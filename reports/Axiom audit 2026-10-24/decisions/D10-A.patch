+// the first `c` of a formula outside braces and environments (`=`: the one `aligned` lines up), or npos
+static size_t topLevel(const std::string &t, char c) {
+  int depth = 0;
+  for (size_t i = 0; i < t.size(); i++) {
+    if (t.compare(i, 7, "\\begin{") == 0) depth++;
+    if (t.compare(i, 5, "\\end{") == 0) depth--;
+    if (t[i] == '\\') { i++; continue; } // \{ \} \& are symbols, not structure
+    if (t[i] == '{') depth++;
+    else if (t[i] == '}') depth--;
+    else if (t[i] == c && depth == 0) return i;
+  }
+  return std::string::npos;
+}
+
+std::string rowBlock(const std::string &texIn) {
+  std::string tex = trim(texIn);
+  size_t open = tex.find('}');
+  if (!startsWith(tex, "\\begin{") || open == std::string::npos) return "";
+  std::string env = tex.substr(7, open - 7), begin = "\\begin{" + env + "}", end = "\\end{" + env + "}";
+  int depth = 0; // the first \begin's own \end must close the formula (two matrices side by side are not one block)
+  for (size_t i = 0; i < tex.size(); i++) {
+    if (tex.compare(i, begin.size(), begin) == 0) depth++;
+    else if (tex.compare(i, end.size(), end) == 0 && --depth == 0) return i + end.size() == tex.size() ? env : "";
+  }
+  return "";
+}
+
+bool wholeFormula(const std::string &tex, const std::string &row) {
+  std::string env = rowBlock(tex);
+  return rowBlock(row) == (env.empty() ? "aligned" : env);
