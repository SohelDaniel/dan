+  }
+  CHECK(std::abs(b[2].box.y - b[0].box.y) < 0.1f);                                       // three rows fit: nothing moved
+  CHECK(b[4].box.y < b[0].box.y - 5);                                                     // five don't: it slid up,
+  CHECK(b[4].box.y > b[0].box.y - (b[4].box.height - b[0].box.height) / 2 + 2);          // but less than re-centring would
+  // a wider left-hand side arriving: the = column stays, the block extends to the left
+  auto w = derivation("\\begin{aligned} 2x &= 8 \\end{aligned}", {"x^2 + 10x + 25 &= 33"}, false);
+  CHECK(std::abs(w[1].eqX - w[0].eqX) < 1.5f);
