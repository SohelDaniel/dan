+// a live (timed) scene of steps 2.5 s apart (1 s morphs, 1.5 s rests), as the checker sees it once each step has
+// settled (layout coordinates). Its formulas are typeset ahead, as the stage has them by the time a step plays.
+static std::vector<place::Picture> settledSteps(const std::string &text, size_t steps, const std::vector<std::string> &formulas) {
+  for (auto &v : formulas) tex::typeset(v);
+  EngineOptions o; // live timing, no window
+  o.quiet = true;
+  o.voice = false;
+  Engine e(o);
+  REQUIRE(e.loadText(text));
+  std::vector<place::Picture> out;
+  for (size_t k = 0; k < steps; k++) {
+    while (e.time() < 1.4f + 2.5f * (float)k) e.update(1.f / 60);
+    out.push_back(e.picture());
+  }
+  return out;
+}
+
+// a derivation that grows by `rows`, after `before` (a plot, ...), each step written as a row (+=) or as the whole
+// formula (->): the formula's box, where its first = sign is, and the stage, once each step has settled
+struct DerivationSample { Rectangle box, stage; float eqX; };
+static std::vector<DerivationSample> derivation(const std::string &first, const std::vector<std::string> &rows, bool append,
+                                                const std::string &before = "") {
+  std::string text = before + "mark eq tex tex=\"" + first + "\"\nwait 1.5s\n";
+  std::vector<std::string> versions{first};
+  for (auto &r : rows) {
+    versions.push_back(texWithRow(versions.back(), r));
+    text += (append ? "morph eq.tex += \"" + r : "morph eq.tex -> \"" + versions.back()) + "\" 1s\nwait 1.5s\n";
+  }
+  std::vector<DerivationSample> out;
+  auto shots = settledSteps(text, versions.size(), versions);
+  for (size_t k = 0; k < shots.size(); k++) {
+    const place::Ink *f = body(shots[k], "eq");
+    REQUIRE(f);
+    const place::Rect &S = shots[k].stage;
+    DerivationSample s{{f->box.x, f->box.y, f->box.w, f->box.h}, {S.x, S.y, S.w, S.h}, 0};
+    TexPtr L = tex::typeset(versions[k]);
+    for (auto &g : L->glyphs)
+      if (g.key == "3D") { s.eqX = f->box.x + g.at.x * f->box.w / L->w; break; } // the first = sign
+    out.push_back(s);
+  }
+  return out;
+}
