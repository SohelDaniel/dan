+  if (row.empty()) return tex;
+  if (wholeFormula(tex, row)) return row;
+  if (tex.empty()) return "\\begin{aligned} " + row + " \\end{aligned}"; // nothing yet: the row starts a derivation
+  if (!env.empty()) { // a block of rows: one more row in it
+    size_t end = tex.size() - env.size() - 6;
+    return trim(tex.substr(0, end)) + " \\\\ " + row + " " + tex.substr(end);
+  }
+  // a plain formula: it and the row become an aligned block; its = is the one lined up unless it has an & already
+  size_t eq = topLevel(tex, '&') == std::string::npos ? topLevel(tex, '=') : std::string::npos;
+  if (eq != std::string::npos) tex = trim(tex.substr(0, eq)) + " &" + tex.substr(eq);
+  return "\\begin{aligned} " + tex + " \\\\ " + row + " \\end{aligned}";
+}
