+// A derivation in the band (a formula that is one block of rows) keeps the rows it had where they were as it changes:
+// its centre is moved by what the new typesetting moved the glyphs it kept (the band keeps its top), so a wider row
+// extends it sideways around them and the = column stands still. The offset lasts while it is held, stays on the
+// stage (eased back when a row would leave it) and goes when a change keeps no glyph. Any other formula is centred.
+void Engine::holdFormula(Mark &m, Rectangle S) {
+  const Value *tx = findProp(m.props, "tex");
+  TexPtr now = texNow(m);
+  if (!tx || tx->type != Value::STR || rowBlock(tx->str).empty() || !now || !now->ok) return;
+  if (!m.texSeen) m.texShift = 0; // a hold starts afresh
+  else if (m.texSeen != now && m.placed) {
+    int pairs = 0;
+    Vector2 d = tex::drift(*m.texSeen, *now, &pairs);
+    float px = texSize(m) / 1000;
+    Vector2 jump{((now->w - m.texSeen->w) / 2 - d.x) * px, ((now->h - m.texSeen->h) / 2 - d.y) * px};
+    if (!pairs) m.texShift = 0;
+    else { m.pos += jump; m.texShift += jump.x; } // drawTex starts the old formula where it was: nothing drawn moves
+  }
+  m.texSeen = now;
+  m.texHeld = true;
+  float half = bodyBounds(m).width / 2, lo = S.x + 8 + half, hi = S.x + S.width - 8 - half;
+  float x = hi > lo ? std::clamp(m.tpos.x + m.texShift, lo, hi) : m.tpos.x;
+  m.texShift = x - m.tpos.x;
+  m.tpos.x = x;
