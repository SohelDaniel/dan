+  std::string first = "\\begin{aligned} x^2 + 6x + 2 &= 0 \\end{aligned}";
+  std::vector<std::string> rows{"x^2 + 6x &= -2", "x^2 + 6x + 9 &= 7", "(x+3)^2 &= 7", "x + 3 &= 3"};
+  auto b = derivation(first, rows, true), whole = derivation(first, rows, false);
+  for (size_t k = 1; k < b.size(); k++) {
+    float top = std::min(b[0].box.y, b[k].stage.y + b[k].stage.height - 8 - b[k].box.height);
+    CHECK_MESSAGE(std::abs(whole[k].box.y - top) < 1.5f, "step " << k << ": top " << whole[0].box.y << " -> " << whole[k].box.y << ", room down to " << top);
+    CHECK_MESSAGE(std::abs(whole[k].eqX - whole[0].eqX) < 1.5f, "step " << k << ": = at " << whole[0].eqX << " -> " << whole[k].eqX);
+    CHECK(b[k].box.height > b[k - 1].box.height);
