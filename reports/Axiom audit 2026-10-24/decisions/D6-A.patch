+  REQUIRE(e.loadText("mark a box label=\"a\"\nmark b box label=\"b\"\n"
+                     "Say: \"This |f|first box is what this is about, for a while.\"\n@f focus a hold\nSay: \"And still.\"\n"));
+  stepInto(e, 1, 1.5f);
+  CHECK(e.litOf("b") < 0.25f);
+  CHECK(e.readback(false).find("focus a hold\n") != std::string::npos);
+  e.interrupt();
+  CHECK(e.readback(false).find("focus") == std::string::npos);
