+// ---- focus (axiom 5): one subject for one sentence; several at once; a held subject, bounded; and its edges
+static EngineOptions liveOpts() { // a live engine without a window or a voice: a focus is timing
+  EngineOptions o;
+  o.quiet = true;
+  o.voice = false;
+  return o;
+}
+static int sentencesStarted(const Engine &e) {
+  int n = 0;
+  for (auto &ev : e.timeline) if (ev.substr(ev.find(' ') + 1, 3) == "say") n++;
+  return n;
+}
+// step at 60 fps until the n-th sentence has started, then `into` seconds more
+static void stepInto(Engine &e, int n, float into) {
+  for (int i = 0; i < 60 * 120 && sentencesStarted(e) < n && !e.finished(); i++) e.update(1.f / 60);
+  REQUIRE(sentencesStarted(e) >= n);
+  for (int i = 0; i < (int)(into * 60); i++) e.update(1.f / 60);
+}
+static bool lintSaying(const Engine &e, const char *prefix, const char *word) {
+  for (auto &l : e.lintMessages()) if (l.rfind(prefix, 0) == 0 && l.find(word) != std::string::npos) return true;
+  return false;
+}
+static const std::string kChorale = "mark sop box voice label=\"soprano\"\nmark alt box voice label=\"alto\"\n"
+                                    "mark ten box voice label=\"tenor\"\nmark bas box voice label=\"bass\"\n"
+                                    "Say: \"A chorale has four voices.\"\n"
+                                    "Say: \"Listen to the |two|outer pair, soprano and bass: they move in contrary motion.\"\n";
+static const std::string kChoraleRest = "Say: \"When the soprano rises, the bass falls, so the outer frame opens.\"\n"
+                                        "Say: \"And when the soprano falls, the bass rises: the frame closes again.\"\n"
+                                        "focus none\n"
+                                        "Say: \"And now all four voices come back together for the cadence.\"\n";
+
+TEST_CASE("focus a,b lights both without a group; the rest dims; everything returns after the sentence") {
+  Engine e(liveOpts());
+  REQUIRE(e.loadText(kChorale + "@two focus sop,bas\n" + kChoraleRest));
+  stepInto(e, 2, 2.5f); // |two| is a second into sentence 2; the dim (7/s) has settled 1.5 s later
+  CHECK(e.litOf("sop") > 0.99f);
+  CHECK(e.litOf("bas") > 0.99f);
+  CHECK(e.litOf("alt") < 0.25f);
+  CHECK(e.litOf("ten") < 0.25f);
+  CHECK(e.readback(false).find("focus sop,bas\n") != std::string::npos);
+  stepInto(e, 3, 1.0f); // no hold: the next sentence has everything back
+  CHECK(e.litOf("alt") > 0.95f);
+  CHECK(e.litOf("ten") > 0.95f);
+  CHECK(e.readback(false).find("focus") == std::string::npos);
+}
+
+TEST_CASE("focus … hold keeps the subject through the sentences about it, until focus none; no lint when closed in time") {
+  Engine e(liveOpts());
+  REQUIRE(e.loadText(kChorale + "@two focus sop,bas hold\n" + kChoraleRest));
+  stepInto(e, 3, 1.0f);
+  CHECK(e.litOf("sop") > 0.99f);
+  CHECK(e.litOf("bas") > 0.99f);
+  CHECK(e.litOf("alt") < 0.25f);
+  CHECK(e.litOf("ten") < 0.25f);
+  CHECK(e.readback(false).find("focus sop,bas hold\n") != std::string::npos);
+  stepInto(e, 4, 1.0f);
+  CHECK(e.litOf("alt") < 0.25f);
+  stepInto(e, 5, 1.0f); // focus none stands before sentence 5
+  CHECK(e.litOf("alt") > 0.95f);
+  CHECK(e.litOf("ten") > 0.95f);
+  CHECK(e.readback(false).find("focus") == std::string::npos);
+  CHECK(!lintSaying(e, "focus:", "hold"));
+}
+
+TEST_CASE("a hold is bounded: after four sentences the engine ends it and says so") {
+  Engine e(liveOpts());
+  std::string s = "mark a box label=\"a\"\nmark b box label=\"b\"\nfocus a hold\n";
+  for (int i = 0; i < 6; i++) s += "Say: \"This sentence is about the first box, and only about it.\"\n";
+  REQUIRE(e.loadText(s));
+  stepInto(e, 4, 1.0f);
+  CHECK(e.litOf("b") < 0.25f); // the fourth sentence is still held
+  stepInto(e, 5, 1.0f);
+  CHECK(e.litOf("b") > 0.95f); // the fifth is not
+  CHECK(e.readback(false).find("focus") == std::string::npos);
+  CHECK(lintSaying(e, "focus:", "hold"));
+}
+
+TEST_CASE("a hold ends with a scene") {
