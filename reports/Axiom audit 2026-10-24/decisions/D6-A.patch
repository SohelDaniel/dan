+}
+
+TEST_CASE("a focus set up after the last sentence ends with the turn, eased, and is reported; streamed, it waits for the turn's end") {
+  const std::string f3 = "mark a bar value=3 label=\"a\"\nmark b bar value=5 label=\"b\"\nmark c bar value=2 label=\"c\"\n";
+  const std::string beat = "Say: \"Three bars sit here.\"\nfocus b\n";
+  Engine e(liveOpts()); // a file: the whole turn
+  REQUIRE(e.loadText(f3 + beat));
+  e.endTurn();
+  for (int i = 0; i < 60 * 30 && !e.finished(); i++) e.update(1.f / 60);
+  for (int i = 0; i < 90; i++) e.update(1.f / 60);
+  CHECK(e.litOf("a") > 0.95f);
+  CHECK(e.readback(false).find("focus") == std::string::npos);
+  CHECK(lintSaying(e, "focus:", "turn"));
+  Engine s(liveOpts()); // the chat: beats appended, the turn's end declared after the last one
+  REQUIRE(s.loadText(f3));
+  REQUIRE(s.appendText(beat));
+  for (int i = 0; i < 60 * 30 && !s.finished(); i++) s.update(1.f / 60);
+  for (int i = 0; i < 90; i++) s.update(1.f / 60);
+  CHECK(s.litOf("a") < 0.25f); // the turn is open: the focus waits for the sentence it is set up for
+  s.endTurn();
+  for (int i = 0; i < 90; i++) s.update(1.f / 60);
+  CHECK(s.litOf("a") > 0.95f);
+  Engine r(instant()); // what --readback prints: the state the next turn builds on
+  played(r, f3 + beat);
+  CHECK(r.readback(false).find("focus") == std::string::npos);
+}
