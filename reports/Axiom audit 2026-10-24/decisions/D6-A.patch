+// ---- focus: what the voice is about (axiom 5)
+void Engine::unfocus() {
+  focus_.clear();
+  focusHeld_ = false;
+  focusSaid_ = 0;
+}
+
+bool Engine::focused(const std::string &ref) const { return std::find(focus_.begin(), focus_.end(), ref) != focus_.end(); }
+
+std::string Engine::focusRef(const std::string &id) const {
+  for (auto &f : focus_) if (baseId(f) == id) return f;
+  return "";
+}
+
+std::string Engine::focusText() const {
+  std::string s;
+  for (auto &f : focus_) s += (s.empty() ? "" : ",") + f;
+  return s;
+}
+
+// under focus a[3] (a[1:3], M[1][:]) the lit cells stay at 1 and the others ease to 0.3: nearer than an unrelated
+// thing's 0.2, they are parts of the lit thing
+float Engine::cellLit(const Mark &m, int k) {
+  for (auto &f : m.cellFocus) for (int c : cellsOf(m, f)) if (c == k) return 1;
+  return 1 - 0.7f * m.cellDim;
+}
+
+float Engine::litOf(const std::string &ref) {
+  int k;
+  std::string id = baseId(ref, &k);
+  Obj *o = find(id);
+  if (!o) return 1;
+  Mark *m = mark(id);
+  return k < 0 || !m ? o->lit : o->lit * cellLit(*m, k);
+}
+
+void Engine::endTurn() {
+  turnDone_ = true;
+  if (finished()) closeTurn();
+}
+
+void Engine::closeTurn() {
+  if (focus_.empty()) return;
+  if (focusSaid_ == 0)
+    warn("focus: '" + focusText() + "' is set after the last sentence, so no sentence is about it: it ended with the turn");
+  unfocus();
+}
+
