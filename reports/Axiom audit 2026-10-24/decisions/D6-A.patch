+TEST_CASE("a held focus reads back as written and re-parses to the same scene; a target never marked is reported") {
+  Engine e(instant());
+  REQUIRE(e.loadText("mark a box label=\"a\"\nmark b box label=\"b\"\nmark c box label=\"c\"\nfocus a,b hold\nSay: \"These here.\"\n"));
+  e.runToEnd(); // the turn is still open: the chat's state mid-turn
+  std::string rb = e.readback(false);
+  CHECK(rb.find("focus a,b hold\n") != std::string::npos);
+  Engine again(instant());
+  REQUIRE(again.loadText(rb));
+  again.runToEnd();
+  CHECK(again.readback(false) == rb);
