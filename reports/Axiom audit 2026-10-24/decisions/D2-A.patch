+  Engine c(instant()); // cued on its word: an event the voice names
+  played(c, "schema axes x=[0,6] y=[0,4]\nmark q dot x=1 y=2 label=\"q\"\nSay: \"It |jumps|jumps across.\"\n@jumps morph q.x -> 5 0s\n");
