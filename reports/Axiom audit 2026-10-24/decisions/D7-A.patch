+// ---------------------------------------------------------------- trails across the fold (the chat keeps the stage as the readback)
+
+// the numbers of a mark's `was=[…]` list in a readback ("-", a jump, reads as NaN)
+static std::vector<double> wasOf(const std::string &rb, const std::string &id) {
+  std::vector<double> out;
+  size_t line = rb.find("mark " + id + " ");
+  size_t at = line == std::string::npos ? line : rb.find("was=[", line);
+  if (at == std::string::npos) return out;
+  std::string body = rb.substr(at + 5, rb.find(']', at) - at - 5), tok;
+  for (std::stringstream ss(body); std::getline(ss, tok, ',');)
+    out.push_back(tok.find_first_of("0123456789") == std::string::npos ? NAN : std::stod(tok));
+  return out;
+}
