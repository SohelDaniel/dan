+// ================================================================ polylines
+static double segDist(V3 p, V3 a, V3 b) {
+  V3 ab = b - a;
+  double l2 = dot(ab, ab);
+  double t = l2 > 0 ? std::clamp(dot(p - a, ab) / l2, 0.0, 1.0) : 0;
+  return norm(p - (a + ab * t));
+}
+
+std::vector<size_t> simplify(const std::vector<V3> &pts, double eps) {
+  std::vector<size_t> keep;
+  if (pts.size() < 3) {
+    for (size_t i = 0; i < pts.size(); i++) keep.push_back(i);
+    return keep;
+  }
+  std::vector<char> kept(pts.size(), 0);
+  kept.front() = kept.back() = 1;
+  std::vector<std::pair<size_t, size_t>> todo{{0, pts.size() - 1}};
+  while (!todo.empty()) { // split each span at its point farthest from the chord, while one is farther than eps
+    auto [a, b] = todo.back();
+    todo.pop_back();
+    double worst = eps;
+    size_t at = 0;
+    for (size_t i = a + 1; i < b; i++)
+      if (double d = segDist(pts[i], pts[a], pts[b]); d > worst) { worst = d; at = i; }
+    if (at) { kept[at] = 1; todo.push_back({a, at}); todo.push_back({at, b}); }
+  }
+  for (size_t i = 0; i < pts.size(); i++) if (kept[i]) keep.push_back(i);
+  return keep;
+}
