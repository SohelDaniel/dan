+// ---- across the fold
+
+bool Engine::keepsTrail(const Mark &m) {
+  double window;
+  bool all = false;
+  return trailSpec(m, window, all) && all && (isAxes(schemaOf(m)) || isSpace(schemaOf(m)));
+}
+
+// `was=`: x,y pairs (x,y,z triples in a space) it went through before where it is now; "-" is a jump
+std::vector<viz::V3> Engine::trailSeed(const Mark &m) {
+  std::vector<viz::V3> out;
+  std::vector<double> v = listNums(m, "was");
+  size_t stride = isSpace(schemaOf(m)) ? 3 : 2;
+  for (size_t i = 0; i < v.size();) {
+    if (!std::isfinite(v[i])) { out.push_back({NAN, NAN, NAN}); i++; continue; }
+    if (i + stride > v.size()) break;
+    out.push_back({v[i], v[i + 1], stride == 3 ? v[i + 2] : 0});
+    i += stride;
+  }
+  return out;
+}
+
+static constexpr size_t kTrailPts = 160; // the most points a carried path is written with
+
+// The whole path so far, in data units: the carried points, then the history walked in the order it
+// happened. The changes one step made (a re-mark's x and y, a morph and its `with` lines) move together,
+// sampled along the way; a `set` that jumps more than 5 % of the path's extent breaks it (a teleport leaves
+// no line). Each run is then reduced to the fewest points within 0.2 % of the extent, axis by axis, so a tall
+// thin plot keeps its corners too; the points are rounded as they will be written, so the written path reads
+// back to itself.
+std::vector<std::vector<viz::V3>> Engine::trailPath(Mark &m) {
+  bool space = isSpace(schemaOf(m));
+  auto round6 = [](double v) { return Value::parse(Value::number(v).markup()).num; };
+  std::vector<viz::V3> pts;
+  std::vector<int> jump;     // per point: 0 moved here, 1 a set changed it here (a jump if far), 2 carried in after a gap
+  std::vector<char> carried; // per point: came in as `was=` (already reduced: kept as it is)
+  bool gap = false, seed = true;
+  auto push = [&](viz::V3 p, int j) {
+    if (!std::isfinite(p.x) || !std::isfinite(p.y) || !std::isfinite(p.z)) { gap = true; return; }
+    viz::V3 q{round6(p.x), round6(p.y), round6(p.z)};
+    if (!gap && !pts.empty() && q.x == pts.back().x && q.y == pts.back().y && q.z == pts.back().z) return; // it stayed
+    pts.push_back(q);
+    jump.push_back(gap ? 2 : j);
+    carried.push_back(seed);
+    gap = false;
+  };
+  for (auto &p : trailSeed(m)) push(p, 0);
+  seed = false;
+
+  std::vector<const HistSeg *> evs; // every change so far, in order
+  for (auto &[key, segs] : hist_) for (auto &h : segs) evs.push_back(&h);
+  std::sort(evs.begin(), evs.end(), [](const HistSeg *a, const HistSeg *b) { return a->seq < b->seq; });
+  auto literal = [&](const char *k) { // a position given as numbers depends on its own changes only; an expression may read anything
+    const Value *v = findProp(m.props, k);
+    if (v && v->type == Value::EXPR) return false;
+    if (auto it = hist_.find(m.id + "." + k); it != hist_.end())
+      for (auto &h : it->second) if (h.before.type == Value::EXPR || h.final.type == Value::EXPR) return false;
+    return true;
+  };
+  bool own = literal("x") && literal("y") && (!space || literal("z"));
+  // the model is put back to before anything changed, walked forward, then restored
+  std::map<std::string, Value> now;
+  for (auto &[key, segs] : hist_)
+    if (Obj *o = find(segs.front().id))
+      if (const Value *cur = findProp(o->props, segs.front().prop)) {
+        now[key] = *cur;
+        setProp(o->props, segs.front().prop, segs.front().before);
+      }
+  auto apply = [&](const HistSeg &h, const Value &v) { if (Obj *o = find(h.id)) setProp(o->props, h.prop, v); };
+  auto at = [&]() {
+    bool hx, hy, hz = true;
+    double x = num(m, "x", &hx), y = num(m, "y", &hy), z = space ? num(m, "z", &hz) : 0;
+    return hx && hy && hz ? viz::V3{x, y, z} : viz::V3{NAN, NAN, NAN};
+  };
+  unsigned born = bornSeq_.count(m.id) ? bornSeq_[m.id] : 0;
+  size_t i = 0;
+  for (; i < evs.size() && evs[i]->seq < born; i++) apply(*evs[i], evs[i]->final); // before it appeared: only the outcome matters
+  push(at(), 0); // where it appeared (or where it was when this scene was loaded)
+  const int kSamples = 128;
+  while (i < evs.size()) {
+    size_t j = i;
+    bool mine = !own;
+    for (; j < evs.size() && evs[j]->step == evs[i]->step; j++) if (evs[j]->id == m.id) mine = true;
+    if (!mine) { // cannot have moved it
+      for (size_t k = i; k < j; k++) apply(*evs[k], evs[k]->final);
+      i = j;
+      continue;
+    }
+    std::vector<const HistSeg *> moves;
+    for (size_t k = i; k < j; k++) {
+      if (evs[k]->set) apply(*evs[k], evs[k]->final); else moves.push_back(evs[k]);
+    }
+    push(at(), 1); // after the step's instant changes
+    if (!moves.empty())
+      for (int s = 1; s <= kSamples; s++) {
+        float k = (float)s / kSamples;
+        for (auto *h : moves) apply(*h, Value::number(h->from + (h->to - h->from) * (h->ease ? h->ease(k) : k)));
+        push(at(), 0);
+      }
+    for (auto *h : moves) apply(*h, h->final); // the exact ends (an expression stays one)
+    i = j;
+  }
+  for (auto &[key, segs] : hist_) if (auto it = now.find(key); it != now.end()) apply(segs.front(), it->second);
+  push(at(), 0); // where it is now, whatever the history missed
+
+  if (pts.size() < 2) return {};
+  viz::V3 lo = pts[0], hi = pts[0];
+  for (auto &p : pts) {
+    lo = {std::min(lo.x, p.x), std::min(lo.y, p.y), std::min(lo.z, p.z)};
+    hi = {std::max(hi.x, p.x), std::max(hi.y, p.y), std::max(hi.z, p.z)};
+  }
+  viz::V3 ext = hi - lo;
+  if (!(std::max({ext.x, ext.y, ext.z}) > 0)) return {}; // it never moved
+  auto unit = [&](viz::V3 p) {
+    return viz::V3{ext.x > 0 ? (p.x - lo.x) / ext.x : 0, ext.y > 0 ? (p.y - lo.y) / ext.y : 0, ext.z > 0 ? (p.z - lo.z) / ext.z : 0};
+  };
+  std::vector<std::vector<viz::V3>> runs(1);
+  std::vector<size_t> lead(1, 0); // per run: how many of its first points were carried in
+  for (size_t k = 0; k < pts.size(); k++) {
+    bool broken = jump[k] == 2 || (jump[k] == 1 && k > 0 && viz::norm(unit(pts[k]) - unit(pts[k - 1])) > 0.05);
+    if (broken && !runs.back().empty()) { runs.emplace_back(); lead.push_back(0); }
+    if (carried[k] && lead.back() == runs.back().size()) lead.back()++;
+    runs.back().push_back(pts[k]);
+  }
+  // a run's first `from` points stay as they are; the rest is reduced to the fewest within eps
+  auto reduce = [&](const std::vector<viz::V3> &run, size_t from, double eps) {
+    std::vector<viz::V3> u, kept(run.begin(), run.begin() + (long)from);
+    for (size_t k = from; k < run.size(); k++) u.push_back(unit(run[k]));
+    for (size_t k : viz::simplify(u, eps)) kept.push_back(run[from + k]);
+    return kept;
+  };
+  // what was carried in is kept as it is; what happened since is reduced from the junction on. Only when the
+  // whole (less where it is now) would be too long is everything reduced again, coarser until it fits
+  std::vector<std::vector<viz::V3>> out;
+  size_t total = 0;
+  for (size_t r = 0; r < runs.size(); r++) {
+    out.push_back(reduce(runs[r], lead[r] ? lead[r] - 1 : 0, 0.002));
+    total += out.back().size();
+  }
+  for (double eps = 0.002; total - 1 > kTrailPts && eps <= 1; eps *= 2) {
+    out.clear();
+    total = 0;
+    for (auto &run : runs) {
+      out.push_back(reduce(run, 0, eps));
+      total += out.back().size();
+    }
+  }
+  return out;
+}
+
+// `was=[…]`: the path before where the thing is now, which its mark line states. A jump that ended there is
+// kept as a closing "-", so a load does not join the carried path to it.
+std::string Engine::trailCarried(Mark &m) {
+  std::vector<std::vector<viz::V3>> runs = trailPath(m);
+  if (runs.empty()) return "";
+  runs.back().pop_back();
+  bool space = isSpace(schemaOf(m));
+  auto fmt = [](double v) { return Value::number(v).markup(); };
+  std::string s;
+  for (size_t r = 0; r < runs.size(); r++) {
+    bool last = r + 1 == runs.size();
+    if (!last && runs[r].size() < 2) continue; // a lone point before a jump draws nothing
+    if (last && runs[r].empty()) {
+      if (!s.empty()) s += ", -";
+      break;
+    }
+    if (!s.empty()) s += ", -, ";
+    for (size_t k = 0; k < runs[r].size(); k++) {
+      const viz::V3 &p = runs[r][k];
+      s += (k ? ", " : "") + fmt(p.x) + ", " + fmt(p.y) + (space ? ", " + fmt(p.z) : "");
+    }
+  }
+  return s.empty() ? "" : "[" + s + "]";
+}
+
 } // namespace mk
