+TEST_CASE("simplify: points on a straight line go, corners stay, and simplifying twice changes nothing") {
+  std::vector<V3> pts;
+  for (int i = 0; i <= 10; i++) pts.push_back({(double)i, 0, 0});
+  pts.push_back({10, 5, 0});
+  CHECK(simplify(pts, 0.01) == std::vector<size_t>{0, 10, 11});
+  std::vector<V3> arc; // a half circle at 1 % tolerance: a handful of points, all within eps
+  for (int i = 0; i <= 100; i++) arc.push_back({std::cos(i * 3.14159265 / 100), std::sin(i * 3.14159265 / 100), 0});
+  std::vector<size_t> k = simplify(arc, 0.01);
+  CHECK(k.size() > 5);
+  CHECK(k.size() < 30);
+  CHECK(k.front() == 0);
+  CHECK(k.back() == 100);
+  std::vector<V3> kept;
+  for (size_t i : k) kept.push_back(arc[i]);
+  CHECK(simplify(kept, 0.01).size() == kept.size());
+  for (size_t j = 0; j + 1 < k.size(); j++) // every dropped point is within eps of the chord that replaced it
+    for (size_t i = k[j]; i <= k[j + 1]; i++) {
+      V3 a = arc[k[j]], b = arc[k[j + 1]], ab = b - a, ap = arc[i] - a;
+      double t = std::max(0.0, std::min(1.0, dot(ap, ab) / dot(ab, ab)));
+      CHECK(norm(arc[i] - (a + ab * t)) <= 0.01 + 1e-12);
+    }
+  CHECK(simplify({}, 1).empty());
+  CHECK(simplify({{1, 2, 3}}, 1) == std::vector<size_t>{0});
