+  played(near, "schema free\nmark a bar input v=3\nmark p label text=\"this one\" at=a color=blue\n");
+  CHECK(!anyLint(near, "zero:"));
+  Engine link(instant()); // a link takes no category, and a formula's term is not the formula: name another colour
+  played(link, "schema graph\nmark a box input\nmark b box process\nmark c box output\nlink g arrow a -> c color=orange\n"
+               "mark f tex tex=\"\\textcolor{orange}{x}\"\n");
+  CHECK(anyLint(link, "zero: 'g' is orange by name and the kind 'process' is orange by palette"));
+  CHECK(anyLint(link, "zero: 'f' is orange by name"));
+  CHECK(!anyLint(link, "give 'g'"));
+  CHECK(!anyLint(link, "give 'f'"));
+}
